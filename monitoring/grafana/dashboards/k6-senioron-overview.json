{
  "title": "k6 + SeniorON (Spring Boot / JVM / HikariCP) Overview",
  "uid": "k6-senioron-overview",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "editable": true,
  "timezone": "",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROM",
        "label": "Prometheus",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "📊 k6 Load Test Metrics",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS (http_reqs / 10s)",
      "datasource": "InfluxDB-k6",
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"value\") FROM \"http_reqs\" WHERE $timeFilter GROUP BY time(10s) fill(null)"
        }
      ],
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "pointSize": 5
          },
          "unit": "reqps"
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Response Time p95 (http_req_duration)",
      "datasource": "InfluxDB-k6",
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT percentile(\"value\",95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time(10s) fill(null)"
        }
      ],
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "auto"
          },
          "unit": "ms"
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Fail Rate (http_req_failed)",
      "datasource": "InfluxDB-k6",
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"value\") FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time(10s) fill(null)"
        }
      ],
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "scheme"
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Signup / Login p95 (custom metrics)",
      "datasource": "InfluxDB-k6",
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT percentile(\"value\",95) FROM \"signup_duration\" WHERE $timeFilter GROUP BY time(10s) fill(null)",
          "alias": "signup p95"
        },
        {
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT percentile(\"value\",95) FROM \"login_duration\" WHERE $timeFilter GROUP BY time(10s) fill(null)",
          "alias": "login p95"
        }
      ],
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme"
          },
          "unit": "ms"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 200,
      "type": "row",
      "title": "🔗 HikariCP Connection Pool",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "HikariCP Connections (active / idle / pending)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{job=\"spring\"}) or sum(hikaricp_connections{job=\"spring\",state=\"active\"})", "legendFormat": "active" },
        { "refId": "B", "expr": "sum(hikaricp_connections_idle{job=\"spring\"}) or sum(hikaricp_connections{job=\"spring\",state=\"idle\"})", "legendFormat": "idle" },
        { "refId": "C", "expr": "sum(hikaricp_connections_pending{job=\"spring\"})", "legendFormat": "pending" }
      ],
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "HikariCP Connection Usage Time (seconds)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "rate(hikaricp_connections_usage_seconds_sum{job=\"spring\"}[$__rate_interval]) / rate(hikaricp_connections_usage_seconds_count{job=\"spring\"}[$__rate_interval])", "legendFormat": "avg usage time" }
      ],
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" },
          "unit": "s"
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 300,
      "type": "row",
      "title": "🌐 Tomcat / HTTP Server",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Tomcat Threads (current vs max)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum(tomcat_threads_current_threads{job=\"spring\"})", "legendFormat": "current" },
        { "refId": "B", "expr": "sum(tomcat_threads_config_max_threads{job=\"spring\"})", "legendFormat": "max" }
      ],
      "gridPos": { "x": 0, "y": 27, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "HTTP Server – Request Rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring\"}[$__rate_interval]))", "legendFormat": "req/s" }
      ],
      "gridPos": { "x": 12, "y": 27, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" },
          "unit": "reqps"
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "HTTP Server p95 Latency (requires *_bucket)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\"}[$__rate_interval])))", "legendFormat": "p95" }
      ],
      "gridPos": { "x": 0, "y": 35, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" },
          "unit": "s"
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "HTTP Server – Avg Latency (seconds) [fallback]",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_sum{job=\"spring\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"spring\"}[$__rate_interval]))", "legendFormat": "avg latency" }
      ],
      "gridPos": { "x": 12, "y": 35, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" },
          "unit": "s"
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 400,
      "type": "row",
      "title": "☕ JVM Metrics",
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "JVM GC Pause (seconds/s)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "rate(jvm_gc_pause_seconds_sum{job=\"spring\"}[$__rate_interval])", "legendFormat": "gc pause" }
      ],
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" },
          "unit": "s"
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "JVM Heap Used vs Max (bytes)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"spring\",area=\"heap\"})", "legendFormat": "used" },
        { "refId": "B", "expr": "sum(jvm_memory_max_bytes{job=\"spring\",area=\"heap\"})", "legendFormat": "max" }
      ],
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" },
          "unit": "bytes"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "JVM Threads (live / peak)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_threads_live_threads{job=\"spring\"})", "legendFormat": "live" },
        { "refId": "B", "expr": "sum(jvm_threads_peak_threads{job=\"spring\"})", "legendFormat": "peak" }
      ],
      "gridPos": { "x": 0, "y": 52, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "JVM Non-Heap Memory Used (bytes)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"spring\",area=\"nonheap\"})", "legendFormat": "non-heap used" }
      ],
      "gridPos": { "x": 12, "y": 52, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" },
          "unit": "bytes"
        }
      },
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 500,
      "type": "row",
      "title": "🔔 Notification / SOS Delivery",
      "gridPos": { "x": 0, "y": 60, "w": 24, "h": 1 }
    },
    {
      "id": 50,
      "type": "timeseries",
      "title": "SOS 발송 결과 (sos_dispatch_total)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (increase(sos_dispatch_total[$__rate_interval]))", "legendFormat": "{{result}}" }
      ],
      "gridPos": { "x": 0, "y": 61, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "FCM 발송 결과 (fcm_send_total)",
      "datasource": { "type": "prometheus", "uid": "$DS_PROM" },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (increase(fcm_send_total[$__rate_interval]))", "legendFormat": "{{result}}" }
      ],
      "gridPos": { "x": 12, "y": 61, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
